{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "autoUpdatesChannel": "stable",
  "effortLevel": "high",
  "showThinkingSummaries": true,
  "alwaysThinkingEnabled": true,
  "permissions": {
    "allow": [
      "Bash(ls)",
      "Bash(ls .)",
      "Bash(ls ./*)",
      "Bash(wc ./*)"
    ],
    "deny": [
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.profile_local)",
      "Read(~/.bash_local)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./secret/**)",
      "Write(~/.netrc)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.profile_local)",
      "Write(~/.bash_local)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)",
      "Write(./secret/**)",
      "Bash(cat ~/.netrc*)",
      "Bash(cat ~/.ssh/**)",
      "Bash(cat ~/.aws/**)",
      "Bash(cat ~/.profile_local*)",
      "Bash(cat ~/.bash_local*)",
      "Bash(cat ./.env*)",
      "Bash(cat ./secrets/**)",
      "Bash(cat ./secret/**)",
      "Bash(less ~/.netrc*)",
      "Bash(less ~/.ssh/**)",
      "Bash(less ~/.aws/**)",
      "Bash(less ~/.profile_local*)",
      "Bash(less ~/.bash_local*)",
      "Bash(less ./.env*)",
      "Bash(less ./secrets/**)",
      "Bash(less ./secret/**)",
      "Bash(more ~/.netrc*)",
      "Bash(more ~/.ssh/**)",
      "Bash(more ~/.aws/**)",
      "Bash(more ~/.profile_local*)",
      "Bash(more ~/.bash_local*)",
      "Bash(more ./.env*)",
      "Bash(more ./secrets/**)",
      "Bash(more ./secret/**)",
      "Bash(head ~/.netrc*)",
      "Bash(head ~/.ssh/**)",
      "Bash(head ~/.aws/**)",
      "Bash(head ~/.profile_local*)",
      "Bash(head ~/.bash_local*)",
      "Bash(head ./.env*)",
      "Bash(head ./secrets/**)",
      "Bash(head ./secret/**)",
      "Bash(tail ~/.netrc*)",
      "Bash(tail ~/.ssh/**)",
      "Bash(tail ~/.aws/**)",
      "Bash(tail ~/.profile_local*)",
      "Bash(tail ~/.bash_local*)",
      "Bash(tail ./.env*)",
      "Bash(tail ./secrets/**)",
      "Bash(tail ./secret/**)",
      "Bash(grep ~/.netrc*)",
      "Bash(grep ~/.ssh/**)",
      "Bash(grep ~/.aws/**)",
      "Bash(grep ~/.profile_local*)",
      "Bash(grep ~/.bash_local*)",
      "Bash(grep ./.env*)",
      "Bash(grep ./secrets/**)",
      "Bash(grep ./secret/**)",
      "Bash(awk ~/.netrc*)",
      "Bash(awk ~/.ssh/**)",
      "Bash(awk ~/.aws/**)",
      "Bash(awk ~/.profile_local*)",
      "Bash(awk ~/.bash_local*)",
      "Bash(awk ./.env*)",
      "Bash(awk ./secrets/**)",
      "Bash(awk ./secret/**)",
      "Bash(sed ~/.netrc*)",
      "Bash(sed ~/.ssh/**)",
      "Bash(sed ~/.aws/**)",
      "Bash(sed ~/.profile_local*)",
      "Bash(sed ~/.bash_local*)",
      "Bash(sed ./.env*)",
      "Bash(sed ./secrets/**)",
      "Bash(sed ./secret/**)",
      "Bash(wc ~/.netrc*)",
      "Bash(wc ~/.ssh/**)",
      "Bash(wc ~/.aws/**)",
      "Bash(wc ~/.profile_local*)",
      "Bash(wc ~/.bash_local*)",
      "Bash(wc ./.env*)",
      "Bash(wc ./secrets/**)",
      "Bash(wc ./secret/**)",
      "Bash(ls ~/.netrc*)",
      "Bash(ls ~/.ssh/**)",
      "Bash(ls ~/.aws/**)",
      "Bash(ls ~/.profile_local*)",
      "Bash(ls ~/.bash_local*)",
      "Bash(ls ./.env*)",
      "Bash(ls ./secrets/**)",
      "Bash(ls ./secret/**)"
    ],
    "ask": [
      "WebFetch",
      "Bash(wget *)",
      "Bash(curl *)",
      "Bash(ping *)",
      "Bash(nc *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rm -rf *)",
      "Bash(env)",
      "Bash(printenv)"
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1"
  }
}
