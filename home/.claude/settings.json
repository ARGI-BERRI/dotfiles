{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "autoUpdatesChannel": "stable",
  "effortLevel": "high",
  "showThinkingSummaries": true,
  "alwaysThinkingEnabled": true,
  "permissions": {
    "allow": [
      "Bash(ls)",
      "Bash(ls .)",
      "Bash(ls ./*)",
      "Bash(wc ./*)"
    ],
    "deny": [
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.profile_local)",
      "Read(~/.bash_local)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./secret/**)",
      "Write(~/.netrc)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.profile_local)",
      "Write(~/.bash_local)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)",
      "Write(./secret/**)",
      "Bash(* ~/.netrc*)",
      "Bash(* ~/.ssh/**)",
      "Bash(* ~/.aws/**)",
      "Bash(* ~/.profile_local*)",
      "Bash(* ~/.bash_local*)",
      "Bash(* ./.env*)",
      "Bash(* ./secrets/**)",
      "Bash(* ./secret/**)",
      "Bash(cat ~/.netrc*)",
      "Bash(cat ~/.ssh/**)",
      "Bash(cat ~/.aws/**)",
      "Bash(cat ~/.profile_local*)",
      "Bash(cat ~/.bash_local*)",
      "Bash(cat ./.env*)",
      "Bash(cat ./secrets/**)",
      "Bash(cat ./secret/**)",
      "Bash(cp ~/.netrc*)",
      "Bash(cp ~/.ssh/**)",
      "Bash(cp ~/.aws/**)",
      "Bash(cp ~/.profile_local*)",
      "Bash(cp ~/.bash_local*)",
      "Bash(cp ./.env*)",
      "Bash(cp ./secrets/**)",
      "Bash(cp ./secret/**)",
      "Bash(mv ~/.netrc*)",
      "Bash(mv ~/.ssh/**)",
      "Bash(mv ~/.aws/**)",
      "Bash(mv ~/.profile_local*)",
      "Bash(mv ~/.bash_local*)",
      "Bash(mv ./.env*)",
      "Bash(mv ./secrets/**)",
      "Bash(mv ./secret/**)",
      "Bash(tar ~/.netrc*)",
      "Bash(tar ~/.ssh/**)",
      "Bash(tar ~/.aws/**)",
      "Bash(tar ~/.profile_local*)",
      "Bash(tar ~/.bash_local*)",
      "Bash(tar ./.env*)",
      "Bash(tar ./secrets/**)",
      "Bash(tar ./secret/**)",
      "Bash(rm ~/.netrc*)",
      "Bash(rm ~/.ssh/**)",
      "Bash(rm ~/.aws/**)",
      "Bash(rm ~/.profile_local*)",
      "Bash(rm ~/.bash_local*)",
      "Bash(rm ./.env*)",
      "Bash(rm ./secrets/**)",
      "Bash(rm ./secret/**)"
    ],
    "ask": [
      "WebFetch",
      "Bash(wget *)",
      "Bash(curl *)",
      "Bash(ping *)",
      "Bash(nc *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rm -rf *)",
      "Bash(env)",
      "Bash(printenv)"
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1"
  }
}
